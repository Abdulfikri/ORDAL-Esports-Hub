# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- AUTHENTICATION & INITIAL SEED CREDENTIALS (SERVER-SIDE ONLY) ---
# Set strong unique passwords in your local .env or deployment secret manager.
# Never commit real credentials or .env files to source control.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="CHANGE_ME_STRONG_ADMIN_PASSWORD"
SEED_CASTER_1_EMAIL="caster1@example.com"
SEED_CASTER_2_EMAIL="caster2@example.com"
SEED_CASTER_3_EMAIL="caster3@example.com"
SEED_CASTER_PASSWORD="CHANGE_ME_STRONG_CASTER_PASSWORD"
SEED_TEAM_EMAIL="team@example.com"
SEED_TEAM_PASSWORD="CHANGE_ME_STRONG_TEAM_PASSWORD"
SEED_LEAGUE_OPS_EMAIL="leagueops@example.com"
SEED_LEAGUE_OPS_PASSWORD="CHANGE_ME_STRONG_LEAGUE_OPS_PASSWORD"
AUTH_SESSION_TTL_HOURS="24"
AUTH_INACTIVITY_TIMEOUT_MINUTES="30"

# --- INDONESIAN PAYMENT GATEWAY (SERVER-SIDE ONLY) ---
# Supported providers: SANDBOX | MIDTRANS | XENDIT
PAYMENT_GATEWAY_PROVIDER="SANDBOX"
PAYMENT_GATEWAY_SERVER_KEY=""
PAYMENT_GATEWAY_WEBHOOK_SECRET=""
PAYMENT_GATEWAY_WEBHOOK_IP_ALLOWLIST=""
PAYMENT_ALLOW_SANDBOX="true"

# --- PRODUCTION SECURITY HARDENING ---
# Enable strict CSP & X-Frame-Options when deployed outside AI Studio preview iframe
STRICT_PRODUCTION_HEADERS="false"
ALLOW_PREVIEW_IFRAME="true"
CSP_FRAME_ANCESTORS=""

# Real-time SOC Alert Webhook (Discord / Slack / SIEM HTTPS endpoint)
SOC_ALERT_WEBHOOK_URL=""

# Transactional Email Delivery for Password Reset OTP (Resend)
RESEND_API_KEY=""
EMAIL_FROM=""

# Cloudflare Turnstile Anti-Bot Verification (register, forgot-password, public squad registration)
TURNSTILE_SECRET_KEY=""
VITE_TURNSTILE_SITE_KEY=""

