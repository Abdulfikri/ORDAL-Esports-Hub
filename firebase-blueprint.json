      "title": "UserProfile",
      "description": "Registered ORDAL user profile and RBAC role assignment keyed by Firebase Auth UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 200
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "role": {
          "type": "string",
          "enum": ["TEAM", "CASTER", "LEAGUE_OPS", "SUPER_ADMIN"]
        },
        "casterId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "inviteId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "teamProfile": {
          "type": "object"
        },
        "createdAt": {
          "type": "string",
          "maxLength": 64
        }
      },
      "required": ["uid", "email", "displayName", "role", "createdAt"]
    },
